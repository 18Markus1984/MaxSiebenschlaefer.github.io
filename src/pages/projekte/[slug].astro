---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getProjects, type Project } from '../../lib/projects';
import { url, projectImage } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const d = project.data;
const links = [
  d.links.github && { label: 'Code auf GitHub', href: d.links.github },
  d.links.printables && { label: 'Druckdateien auf Printables', href: d.links.printables },
  d.links.youtube && { label: 'Video auf YouTube', href: d.links.youtube },
].filter(Boolean) as { label: string; href: string }[];
const back = d.category === 'elektronik' ? { href: url('/elektronik/'), label: 'Alle Elektronik-Projekte' } : { href: url('/'), label: 'Alle Projekte' };
---
<Base title={d.title} description={d.summary} current={d.category === 'elektronik' ? 'elektronik' : 'start'}>
  <article>
    <p style="margin-top:16px"><a href={back.href} class="sec">{back.label}</a></p>
    <div class="project-hero">
      <div style="display:flex;flex-direction:column;gap:18px">
        <p class="sec" style="font-size:15px">{[d.controller, d.year, d.status === 'in Arbeit' ? 'in Arbeit' : null].filter(Boolean).join(', ')}</p>
        <h1>{d.title}</h1>
        <p class="sec" style="font-size:19px;max-width:40ch">{d.summary}</p>
        {links.length > 0 && (
          <div class="actions">
            {links.map((l, i) => <a class={`btn ${i === 0 ? 'btn-p' : 'btn-s'}`} href={l.href}>{l.label}</a>)}
          </div>
        )}
      </div>
      {d.image
        ? <img class="feat-img" src={projectImage(d.image)} alt={d.imageAlt ?? ''} width="600" height="450" />
        : <div class="feat-img">Foto folgt</div>}
    </div>
    <div class="section" style="display:grid;gap:40px">
      <div class="prose"><Content /></div>
      {d.specs.length > 0 && (
        <div class="spec" style="max-width:760px">
          {d.specs.map((s) => <div><b>{s.label}</b>{s.value}</div>)}
        </div>
      )}
    </div>
  </article>
</Base>
