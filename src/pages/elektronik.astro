---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import site from '../data/site.json';
import { getProjects, groupByController, cover } from '../lib/projects';
import { url } from '../lib/url';

const projects = await getProjects();
const groups = groupByController(projects.filter((p) => p.data.category === 'elektronik'));
const featured = projects.find((p) => p.data.featured);
---
<Base title="Elektronik" current="elektronik" description="Elektronik-Projekte von Max Siebenschläfer, sortiert nach Mikrocontroller.">
  <section class="board">
    <span class="hole" style="left:22px;top:22px" aria-hidden="true"></span>
    <span class="hole" style="right:22px;top:22px" aria-hidden="true"></span>
    <span class="hole" style="left:22px;bottom:22px" aria-hidden="true"></span>
    <span class="hole" style="right:22px;bottom:22px" aria-hidden="true"></span>
    <div style="display:flex;flex-direction:column;gap:22px">
      <h1>Elektronik, die ich selbst entwerfe, löte und programmiere</h1>
      <p class="lead">ESP32, Arduino und Raspberry Pi in eigenen Geräten. Gehäuse und Firmware gibt es offen dazu.</p>
      <div class="actions">
        <a class="btn btn-silk" href="#controller">Nach Controller</a>
        <a class="btn btn-ghost" href={site.links.github}>GitHub</a>
      </div>
    </div>
    <span class="lg" role="img" aria-label="Logo von Max Siebenschläfer als Bestückungsdruck auf der Platine"></span>
    <div class="header-pins" aria-hidden="true">{Array.from({ length: 24 }).map(() => <span></span>)}</div>
  </section>

  <section id="controller" class="section">
    <h2 class="h2" style="margin-bottom:8px">Projekte nach Mikrocontroller</h2>
    {groups.map(([controller, list]) => (
      <div class="mcu">
        <span class="chip">{controller}</span>
        <div class="cards">
          {list.map((p) => (
            <a class="card" href={url(`/projekte/${p.id}/`)}>
              <Shot shot={cover(p)} ratio={4 / 3} width={132} />
              <div><h3>{p.data.title}</h3><span class="sec">{p.data.summary}</span></div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  {featured && (
    <section id="aktuell" class="section">
      <div class="feat">
        <Shot shot={cover(featured)} ratio={4 / 3} width={600} class="feat-shot" />
        <div style="display:flex;flex-direction:column;gap:18px">
          <h2 class="h2">{featured.data.title}</h2>
          <p class="sec" style="font-size:18px">{featured.data.summary}</p>
          {featured.data.specs.length > 0 && (
            <div class="spec">
              {featured.data.specs.map((s) => <div><b>{s.label}</b>{s.value}</div>)}
            </div>
          )}
          <a href={url(`/projekte/${featured.id}/`)} style="font-weight:600">Zum Projekt</a>
        </div>
      </div>
    </section>
  )}
</Base>
