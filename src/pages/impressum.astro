---
import Base from '../layouts/Base.astro';
// Pflichtangaben nach § 5 DDG. Platzhalter in eckigen Klammern vor dem Veröffentlichen ersetzen.
---
<Base title="Impressum">
  <section class="section prose" style="padding-top:48px;display:grid;gap:16px">
    <h1 style="font-size:44px">Impressum</h1>
    <p>Angaben gemäß § 5 DDG</p>
    <p>[Vor- und Nachname]<br />[Straße und Hausnummer]<br />[PLZ Ort]</p>
    <p>E-Mail: [E-Mail-Adresse]</p>
    <p>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV: [Vor- und Nachname, Anschrift wie oben]</p>
  </section>
</Base>
